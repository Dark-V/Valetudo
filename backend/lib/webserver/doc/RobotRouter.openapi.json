{
  "/api/v2/robot": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot info",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "manufacturer": {
                    "type": "string"
                  },
                  "modelName": {
                    "type": "string"
                  },
                  "modelDetails": {
                    "type": "object",
                    "properties": {
                      "supportedAttachments": {
                        "type": "array",
                        "description": "Attachments that are detected and reported by the robot",
                        "items": {
                          "$ref": "#/components/schemas/AttachmentStateAttributeType"
                        }
                      },
                      "supportedDockComponents": {
                        "type": "array",
                        "description": "Dock components that are detected and reported by the robot",
                        "items": {
                          "$ref": "#/components/schemas/DockComponentStateAttributeType"
                        }
                      }
                    }
                  },
                  "implementation": {
                    "type": "string",
                    "description": "Valetudo robot implementation in use"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/map/editor": {
    "get": {
      "tags": ["Robot"],
      "summary": "Get the current D103CN map edit revision, native rooms and manually placed doors",
      "responses": {
        "200": {"description": "Localized floor ID, geometry revision, pixelSize in cm, rooms, doors and editedCells"},
        "409": {"description": "No verified map for the currently selected floor"}
      }
    },
    "put": {
      "tags": ["Robot"],
      "summary": "Save display cell corrections or manual doors for the current D103CN floor",
      "description": "Each run is [xCell, yCell, length, brush]. Brushes are floor, wall, unknown, native or room:<native segment ID>. The optional doors array replaces only manually placed doors. Points are integer map centimetres.",
      "requestBody": {
        "required": true,
        "content": {"application/json": {"schema": {
          "type": "object",
          "required": ["floorId", "revision"],
          "properties": {
            "floorId": {"type": "integer"},
            "revision": {"type": "string"},
            "runs": {"type": "array", "maxItems": 4096, "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {}}},
            "doors": {"type": "array", "maxItems": 128, "items": {
              "type": "object", "required": ["id", "points", "state"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
                "state": {"type": "string", "enum": ["open", "closed", "unknown"]},
                "points": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}}
              }
            }}
          }
        }}}
      },
      "responses": {
        "200": {"description": "Persisted edit and new revision"},
        "400": {"description": "Invalid runs, door geometry or request limits"},
        "409": {"description": "Floor or geometry revision changed"},
        "500": {"description": "Map edits could not be saved"}
      }
    }
  },
  "/api/v2/robot/state/map/editor/native": {
    "get": {
      "tags": ["Robot"],
      "summary": "Read the actual D103CN room and occupancy layers used by native navigation",
      "responses": {
        "200": {"description": "Floor ID, matching editor revision and unaltered native map layers"},
        "409": {"description": "No verified map for the currently selected floor"}
      }
    }
  },
  "/api/v2/robot/state/map/editor/rooms": {
    "get": {
      "tags": ["Robot"],
      "summary": "Read the current D103CN firmware room edit or recovery operation",
      "responses": {
        "200": {"description": "Last native operation and rollback availability", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/D103CNNativeRoomOperation"}}}}
      }
    },
    "put": {
      "tags": ["Robot"],
      "summary": "Apply room assignments to the native floor",
      "description": "Each run is [xCell, yCell, length, room:<id>]. The target must already exist. Only mapped traversable floor cells can be assigned. The complete request is limited to 65,536 cells. Poll GET for confirmation from the firmware.",
      "requestBody": {
        "required": true,
        "content": {"application/json": {"schema": {
          "type": "object", "required": ["floorId", "revision", "nativeRevision", "runs"],
          "properties": {
            "floorId": {"type": "integer", "minimum": 0, "maximum": 999999},
            "revision": {"type": "string"},
            "nativeRevision": {"type": "string", "description": "Saved navigation raster revision returned by rooms/layers for this draft"},
            "runs": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {
              "type": "array", "minItems": 4, "maxItems": 4, "items": {"oneOf": [{"type": "integer"}, {"type": "string", "pattern": "^room:[1-9][0-9]?$"}]}
            }}
          }
        }}}
      },
      "responses": {
        "202": {"description": "Accepted for backup, apply and readback", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/D103CNNativeRoomOperation"}}}},
        "400": {"description": "Invalid room assignments"},
        "409": {"description": "The floor, revision, raster or operation state does not permit this change"}
      }
    }
  },
  "/api/v2/robot/state/map/editor/rooms/layers": {
    "get": {
      "tags": ["Robot"],
      "summary": "Read the saved D103CN room divider raster for the native brush",
      "description": "Each room includes its full labelled area and a nativePaintablePixels count of eligible floor cells. nativeUnavailableRuns contains [x, y, length] triples for labelled cells that may not be reassigned. Room writes must retain the nativeRevision from this response.",
      "responses": {
        "200": {"description": "Saved floor geometry and both draft revisions", "content": {"application/json": {"schema": {
          "type": "object", "required": ["floorId", "revision", "nativeRevision", "layers"],
          "properties": {
            "floorId": {"type": "integer"}, "revision": {"type": "string"}, "nativeRevision": {"type": "string"},
            "layers": {"type": "array", "items": {"$ref": "#/components/schemas/MapLayer"}}
          }
        }}}},
        "409": {"description": "No stable, localized native floor is available"}
      }
    }
  },
  "/api/v2/robot/state/map/editor/rooms/restore": {
    "post": {
      "tags": ["Robot"],
      "summary": "Undo a confirmed D103CN room edit or recover an interrupted floor update",
      "description": "Normal undo reverses the committed cell assignments against the current native map. Recovery from an incomplete apply can require restoring the full pre-edit floor snapshot.",
      "requestBody": {
        "required": true,
        "content": {"application/json": {"schema": {
          "type": "object", "required": ["floorId", "operationId"],
          "properties": {"floorId": {"type": "integer", "minimum": 0, "maximum": 999999}, "operationId": {"type": "string", "format": "uuid"}}
        }}}
      },
      "responses": {
        "202": {"description": "Undo or recovery accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/D103CNNativeRoomOperation"}}}},
        "400": {"description": "Invalid restore request"},
        "409": {"description": "Operation or selected native floor no longer matches"}
      }
    }
  },
  "components": {
    "schemas": {
      "D103CNNativeRoomOperation": {
        "type": "object",
        "required": ["available", "phase", "floorId", "roomIds", "message", "operationId", "canRollback"],
        "properties": {
          "available": {"type": "boolean"},
          "phase": {"type": "string", "enum": ["idle", "applying", "confirmed", "failed", "restoring", "restored", "needs_recovery"]},
          "floorId": {"type": "integer", "nullable": true},
          "roomIds": {"type": "array", "items": {"type": "string"}},
          "message": {"type": "string"},
          "operationId": {"type": "string", "format": "uuid", "nullable": true},
          "canRollback": {"type": "boolean"}
        }
      }
    }
  },
  "/api/v2/robot/properties": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot-specific properties",
      "responses": {
        "200": {
          "description": "A flat key/value object containing 0..* properties that are specific to this robot.\n\nThis can for example be the firmware version.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot state",
      "description": "Retrieve the robot state.\n\nNote! If the map is available, trying this out on Swagger will likely **use lots of RAM and hang your\nbrowser tab.**\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "attributes": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/AttachmentStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/BatteryStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/DockComponentStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/DockStatusStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/PresetSelectionStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/StatusStateAttribute"
                        }
                      ]
                    }
                  },
                  "map": {
                    "$ref": "#/components/schemas/ValetudoMap"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/attributes": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot state attributes",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AttachmentStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/BatteryStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/DockComponentStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/DockStatusStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/PresetSelectionStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/StatusStateAttribute"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/map": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot map",
      "description": "Retrieve the robot map.\n\nNote! If the map is available, trying this out on Swagger will likely **use lots of RAM and hang your\nbrowser tab.**\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValetudoMap"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/sse": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot state (SSE events)",
      "description": "Retrieve the robot state.\n\nNote! This endpoint provides SSE events. Swagger does not support it.\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "text/event-stream": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/attributes/sse": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot state attributes (SSE events)",
      "description": "Retrieve the robot state attributes.\n\nNote! This endpoint provides SSE events. Swagger does not support it.\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "text/event-stream": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/map/sse": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot map (SSE events)",
      "description": "Retrieve the robot map\n\nNote! This endpoint provides SSE events. Swagger does not support it.\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "text/event-stream": {
              "schema": {
                "$ref": "#/components/schemas/ValetudoMap"
              }
            }
          }
        }
      }
    }
  }
}
