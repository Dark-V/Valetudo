{
  "/api/v2/robot": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot info",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "manufacturer": {
                    "type": "string"
                  },
                  "modelName": {
                    "type": "string"
                  },
                  "modelDetails": {
                    "type": "object",
                    "properties": {
                      "supportedAttachments": {
                        "type": "array",
                        "description": "Attachments that are detected and reported by the robot",
                        "items": {
                          "$ref": "#/components/schemas/AttachmentStateAttributeType"
                        }
                      },
                      "supportedDockComponents": {
                        "type": "array",
                        "description": "Dock components that are detected and reported by the robot",
                        "items": {
                          "$ref": "#/components/schemas/DockComponentStateAttributeType"
                        }
                      }
                    }
                  },
                  "implementation": {
                    "type": "string",
                    "description": "Valetudo robot implementation in use"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/map/editor": {
    "get": {
      "tags": ["Robot"],
      "summary": "Get the current D103CN map edit revision, native rooms and manually placed doors",
      "responses": {
        "200": {"description": "Localized floor ID, geometry revision, pixelSize in cm, rooms, doors and editedCells"},
        "409": {"description": "No verified map for the currently selected floor"}
      }
    },
    "put": {
      "tags": ["Robot"],
      "summary": "Save display cell corrections or manual doors for the current D103CN floor",
      "description": "Each run is [xCell, yCell, length, brush]. Brushes are floor, wall, unknown, native or room:<native segment ID>. The optional doors array replaces only manually placed doors. Points are integer map centimetres.",
      "requestBody": {
        "required": true,
        "content": {"application/json": {"schema": {
          "type": "object",
          "required": ["floorId", "revision"],
          "properties": {
            "floorId": {"type": "integer"},
            "revision": {"type": "string"},
            "runs": {"type": "array", "maxItems": 4096, "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {}}},
            "doors": {"type": "array", "maxItems": 128, "items": {
              "type": "object", "required": ["id", "points", "state"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
                "state": {"type": "string", "enum": ["open", "closed", "unknown"]},
                "points": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}}
              }
            }}
          }
        }}}
      },
      "responses": {
        "200": {"description": "Persisted edit and new revision"},
        "400": {"description": "Invalid runs, door geometry or request limits"},
        "409": {"description": "Floor or geometry revision changed"},
        "500": {"description": "Map edits could not be saved"}
      }
    }
  },
  "/api/v2/robot/state/map/editor/native": {
    "get": {
      "tags": ["Robot"],
      "summary": "Read the actual D103CN room and occupancy layers used by native navigation",
      "responses": {
        "200": {"description": "Floor ID, matching editor revision and unaltered native map layers"},
        "409": {"description": "No verified map for the currently selected floor"}
      }
    }
  },
  "/api/v2/robot/properties": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot-specific properties",
      "responses": {
        "200": {
          "description": "A flat key/value object containing 0..* properties that are specific to this robot.\n\nThis can for example be the firmware version.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot state",
      "description": "Retrieve the robot state.\n\nNote! If the map is available, trying this out on Swagger will likely **use lots of RAM and hang your\nbrowser tab.**\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "attributes": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/AttachmentStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/BatteryStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/DockComponentStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/DockStatusStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/PresetSelectionStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/StatusStateAttribute"
                        }
                      ]
                    }
                  },
                  "map": {
                    "$ref": "#/components/schemas/ValetudoMap"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/attributes": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot state attributes",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AttachmentStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/BatteryStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/DockComponentStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/DockStatusStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/PresetSelectionStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/StatusStateAttribute"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/map": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot map",
      "description": "Retrieve the robot map.\n\nNote! If the map is available, trying this out on Swagger will likely **use lots of RAM and hang your\nbrowser tab.**\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValetudoMap"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/sse": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot state (SSE events)",
      "description": "Retrieve the robot state.\n\nNote! This endpoint provides SSE events. Swagger does not support it.\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "text/event-stream": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/attributes/sse": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot state attributes (SSE events)",
      "description": "Retrieve the robot state attributes.\n\nNote! This endpoint provides SSE events. Swagger does not support it.\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "text/event-stream": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/map/sse": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot map (SSE events)",
      "description": "Retrieve the robot map\n\nNote! This endpoint provides SSE events. Swagger does not support it.\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "text/event-stream": {
              "schema": {
                "$ref": "#/components/schemas/ValetudoMap"
              }
            }
          }
        }
      }
    }
  }
}
